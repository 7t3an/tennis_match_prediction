# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/

# Jupyter notebooks (not needed at runtime)
notebooks/

# Git
.git/
.gitignore

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Processed data (regenerated by training script)
# Comment out the next line if you want processed CSVs inside the container
data/processed/

# Test and dev files
tests/
*.test.py

# Docker files (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
