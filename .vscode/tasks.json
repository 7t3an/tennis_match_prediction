{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Streamlit (venv)",
      "type": "shell",
      "command": "\"${workspaceFolder}/.venv/bin/python\"",
      "args": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501",
        "--server.fileWatcherType",
        "none"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Stop Streamlit",
      "type": "shell",
      "command": "pkill -f \"streamlit run app.py\" || kill $(lsof -ti:8501) || true",
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}